<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <!-- Syncfusion Blazor components theme (Material 3). App styles load after it
         so shell colors override the theme's e-menu text and caret. -->
    <link rel="stylesheet" href="@Assets["_content/Syncfusion.Blazor.Themes/material3.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MdiWorkbench.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <!-- Syncfusion Blazor core interop script -->
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
    <!-- Syncfusion Blazor PDF Viewer script -->
    <script src="@Assets["_content/Syncfusion.Blazor.SfPdfViewer/scripts/syncfusion-blazor-sfpdfviewer.min.js"]" type="text/javascript"></script>
    <!-- Syncfusion Blazor Spreadsheet script -->
    <script src="@Assets["_content/Syncfusion.Blazor.Spreadsheet/scripts/syncfusion-blazor-spreadsheet.min.js"]" type="text/javascript"></script>
    <!-- MDI workspace interop helpers (viewport size for cascade/tile) -->
    <script src="/mdi-interop.js"></script>
</body>

</html>
