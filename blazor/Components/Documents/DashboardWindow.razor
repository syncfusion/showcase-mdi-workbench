@using MdiWorkbench.Models
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Grids
<div class="document-window document-window-dashboard">

        <div class="demo-dashboard-header">
            <div class="demo-dashboard-title">
                <h2 id="sales-dashboard-title">Sales Performance</h2>
                <p>Overview of revenue, orders, and product mix.</p>
            </div>
          
        </div>

        <section class="dashboard-grid row g-3" aria-labelledby="sales-dashboard-title">

                @* ── Row 0: KPI cards ─────────────────────────────────────── *@
                <article class="dashboard-panel dashboard-kpi col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-panel-header">Revenue</div>
                    <div class="dashboard-panel-body">
                        <div class="kpi-value">@_summary.TotalRevenue.ToString("C0")</div>
                        <div class="kpi-sub">YTD</div>
                        <div class="demo-kpi-foot">
                            <span class="demo-trend @(_summary.RevenueDeltaPercent >= 0 ? "demo-trend-up" : "demo-trend-down")">
                                @(_summary.RevenueDeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(_summary.RevenueDeltaPercent).ToString("0.0")%
                            </span>
                        </div>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-kpi col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-panel-header">Orders</div>
                    <div class="dashboard-panel-body">
                        <div class="kpi-value">@_summary.TotalOrders.ToString("N0")</div>
                        <div class="kpi-sub">this year</div>
                        <div class="demo-kpi-foot">
                            <span class="demo-trend @(_summary.OrdersDeltaPercent >= 0 ? "demo-trend-up" : "demo-trend-down")">
                                @(_summary.OrdersDeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(_summary.OrdersDeltaPercent).ToString("0.0")%
                            </span>
                        </div>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-kpi col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-panel-header">Active Users</div>
                    <div class="dashboard-panel-body">
                        <div class="kpi-value">@_summary.ActiveUsers.ToString("N0")</div>
                        <div class="kpi-sub">last 30 days</div>
                        <div class="demo-kpi-foot">
                            <span class="demo-trend @(_summary.UsersDeltaPercent >= 0 ? "demo-trend-up" : "demo-trend-down")">
                                @(_summary.UsersDeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(_summary.UsersDeltaPercent).ToString("0.0")%
                            </span>
                        </div>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-kpi col-12 col-sm-6 col-xl-3">
                    <div class="dashboard-panel-header">Conversion</div>
                    <div class="dashboard-panel-body">
                        <div class="kpi-value">@_summary.ConversionRatePercent.ToString("0.00")%</div>
                        <div class="kpi-sub">site-wide</div>
                        <div class="demo-kpi-foot">
                            <span class="demo-trend @(_summary.ConversionDeltaPercent >= 0 ? "demo-trend-up" : "demo-trend-down")">
                                @(_summary.ConversionDeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(_summary.ConversionDeltaPercent).ToString("0.00")%
                            </span>
                        </div>
                    </div>
                </article>

                @* ── Rows 1–2: Monthly Revenue + Daily Orders ──────────────── *@
                <article class="dashboard-panel dashboard-chart col-12 col-xl-6">
                    <div class="dashboard-panel-header">Monthly Revenue</div>
                    <div class="dashboard-panel-body">
                        <SfChart Title="">
                            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"></ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Title="USD" Format="C0"></ChartPrimaryYAxis>
                            <ChartTooltipSettings Enable="true" Format="C0"></ChartTooltipSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@_monthlyRevenue" XName="Label" YName="Value"
                                             Name="Revenue" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                             Fill="#5b8def" ColumnSpacing="0.25">
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-chart col-12 col-xl-6">
                    <div class="dashboard-panel-header">Daily Orders (this week)</div>
                    <div class="dashboard-panel-body">
                        <SfChart Title="">
                            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"></ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Title="Orders"></ChartPrimaryYAxis>
                            <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@_dailyOrders" XName="Label" YName="Value"
                                             Name="Orders" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Line"
                                             Fill="#22c55e" Width="3">
                                    <ChartMarker Visible="true" Width="8" Height="8" Fill="#22c55e"></ChartMarker>
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </article>

                @* ── Row 3: pies ───────────────────────────────────────────── *@
                <article class="dashboard-panel dashboard-pie col-12 col-lg-6">
                    <div class="dashboard-panel-header">By Category</div>
                    <div class="dashboard-panel-body">
                        <SfAccumulationChart Title="" Width="250px" Height="250px">
                            <AccumulationChartSeriesCollection>
                                <AccumulationChartSeries DataSource="@_categoryBreakdown" XName="Label" YName="Value"
                                                         Name="Share"
                                                         Type="Syncfusion.Blazor.Charts.AccumulationType.Pie"
                                                        >
                                </AccumulationChartSeries>
                            </AccumulationChartSeriesCollection>
                            <AccumulationChartLegendSettings Visible="true" Position="LegendPosition.Bottom"></AccumulationChartLegendSettings>
                        </SfAccumulationChart>
                    </div>
                </article>

                @* ── Rows 4–5: Revenue vs Orders + Top Products ─────────────── *@
                <article class="dashboard-panel dashboard-chart col-12 col-xl-6">
                    <div class="dashboard-panel-header">Revenue vs Orders (by quarter)</div>
                    <div class="dashboard-panel-body">
                        <SfChart Title="">
                            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"></ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Title="USD" Format="C0"></ChartPrimaryYAxis>
                            <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                            <ChartLegendSettings Visible="true" Position="LegendPosition.Bottom"></ChartLegendSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@_revenueVsOrders" XName="Label" YName="Value"
                                             Name="Revenue" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                             Fill="#5b8def" ColumnSpacing="0.2">
                                </ChartSeries>
                                <ChartSeries DataSource="@_revenueVsOrders" XName="Label" YName="SecondaryValue"
                                             Name="Orders" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column"
                                             Fill="#f59e0b" ColumnSpacing="0.2">
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-chart col-12 col-xl-6">
                    <div class="dashboard-panel-header">Top Products (by price)</div>
                    <div class="dashboard-panel-body">
                        <SfChart Title="">
                            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" IsInversed="true"></ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Title="USD" Format="C0"></ChartPrimaryYAxis>
                            <ChartTooltipSettings Enable="true" Format="C0" Header="${point.x}"></ChartTooltipSettings>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="@_topProducts" XName="Label" YName="Value"
                                             Name="Price" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Bar"
                                             Fill="#8b5cf6">
                                </ChartSeries>
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </article>

                @* ── Rows 6–7: Top Sellers grid + Recent Activity feed ──────── *@
                <article class="dashboard-panel dashboard-table col-12 col-xl-6">
                    <div class="dashboard-panel-header">Top Sellers</div>
                    <div class="dashboard-panel-body">
                        <SfGrid DataSource="@_topSellers" AllowSorting="false" AllowPaging="false"
                                AllowFiltering="false" GridLines="GridLine.None">
                            <GridColumns>
                                <GridColumn Field="@nameof(TopSellerRow.Sku)" HeaderText="SKU" Width="100"></GridColumn>
                                <GridColumn Field="@nameof(TopSellerRow.Name)" HeaderText="Product" Width="150"></GridColumn>
                                <GridColumn Field="@nameof(TopSellerRow.UnitsSold)" HeaderText="Units" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="70"></GridColumn>
                                <GridColumn Field="@nameof(TopSellerRow.Revenue)" HeaderText="Revenue" Format="C0" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="100"></GridColumn>
                                <GridColumn HeaderText="Δ" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="80">
                                    <Template>
                                        @{
                                            var row = (context as TopSellerRow)!;
                                            var cls = row.ChangePercent >= 0 ? "demo-trend-up" : "demo-trend-down";
                                            var arrow = row.ChangePercent >= 0 ? "▲" : "▼";
                                        }
                                        <span class="demo-trend @cls">@arrow @Math.Abs(row.ChangePercent).ToString("0.0")%</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </article>

                <article class="dashboard-panel dashboard-table col-12 col-xl-6">
                    <div class="dashboard-panel-header">Recent Activity</div>
                    <div class="dashboard-panel-body">
                        <ul class="demo-activity-list">
                            @foreach (var row in _recentActivity)
                            {
                                <li class="demo-activity-item">
                                    <span class="demo-activity-time">@row.Time</span>
                                    <span class="demo-activity-text">
                                        <strong>@row.Customer</strong> @row.Action
                                    </span>
                                    <span class="demo-activity-amount">@row.Amount.ToString("C0")</span>
                                    <span class="demo-status demo-status-@row.Status.ToLower()">@row.Status</span>
                                </li>
                            }
                        </ul>
                    </div>
                </article>

        </section>
    </div>

